# Export these variables in your shell; Django does not automatically read this file.
JIS_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
# Production requires PostgreSQL and a randomly generated secret >=50 characters.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jis
# SECRET_KEY=generate-a-long-random-secret
# CSRF_TRUSTED_ORIGINS=https://your-host.example
# BOOTSTRAP_EMAIL=registrar@example.test
# BOOTSTRAP_NAME=Project Registrar
# BOOTSTRAP_PASSWORD=set-in-host-secret-manager
