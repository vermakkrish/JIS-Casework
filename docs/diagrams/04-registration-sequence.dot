// Registration sequence: columns are participants; numbered rows are time.
digraph Sequence {
graph [rankdir=TB, pad=.5, nodesep=.65, ranksep=.55, splines=line];
node [fontname="Arial",fontsize=11,color="#456451"]; edge [fontname="Arial",fontsize=10,color="#456451"];
{rank=same; r0 [group="r",shape=box,style=filled,fillcolor="#f7f9f2",label="Registrar"]; b0 [group="b",shape=box,style=filled,fillcolor="#f7f9f2",label="Browser"]; v0 [group="v",shape=box,style=filled,fillcolor="#f7f9f2",label="HTTP view"]; s0 [group="s",shape=box,style=filled,fillcolor="#f7f9f2",label="Application service"]; d0 [group="d",shape=box,style=filled,fillcolor="#f7f9f2",label="Repository / PostgreSQL"]; r0 -> b0 -> v0 -> s0 -> d0 [style=invis,weight=100];}
{rank=same; r1 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b1 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v1 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s1 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d1 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r1 -> b1 -> v1 -> s1 -> d1 [style=invis,weight=100];}
{rank=same; r2 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b2 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v2 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s2 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d2 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r2 -> b2 -> v2 -> s2 -> d2 [style=invis,weight=100];}
{rank=same; r3 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b3 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v3 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s3 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d3 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r3 -> b3 -> v3 -> s3 -> d3 [style=invis,weight=100];}
{rank=same; r4 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b4 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v4 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s4 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d4 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r4 -> b4 -> v4 -> s4 -> d4 [style=invis,weight=100];}
{rank=same; r5 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b5 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v5 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s5 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d5 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r5 -> b5 -> v5 -> s5 -> d5 [style=invis,weight=100];}
{rank=same; r6 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b6 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v6 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s6 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d6 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r6 -> b6 -> v6 -> s6 -> d6 [style=invis,weight=100];}
{rank=same; r7 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b7 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v7 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s7 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d7 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r7 -> b7 -> v7 -> s7 -> d7 [style=invis,weight=100];}
{rank=same; r8 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b8 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v8 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s8 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d8 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r8 -> b8 -> v8 -> s8 -> d8 [style=invis,weight=100];}
{rank=same; r9 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b9 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v9 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s9 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d9 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r9 -> b9 -> v9 -> s9 -> d9 [style=invis,weight=100];}
{rank=same; r10 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b10 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v10 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s10 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d10 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r10 -> b10 -> v10 -> s10 -> d10 [style=invis,weight=100];}
{rank=same; r11 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b11 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v11 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s11 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d11 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r11 -> b11 -> v11 -> s11 -> d11 [style=invis,weight=100];}
{rank=same; r12 [group="r",shape=point,width=.02,height=.02,label="",color="#71856c"]; b12 [group="b",shape=point,width=.02,height=.02,label="",color="#71856c"]; v12 [group="v",shape=point,width=.02,height=.02,label="",color="#71856c"]; s12 [group="s",shape=point,width=.02,height=.02,label="",color="#71856c"]; d12 [group="d",shape=point,width=.02,height=.02,label="",color="#71856c"]; r12 -> b12 -> v12 -> s12 -> d12 [style=invis,weight=100];}
{rank=same; r13 [group="r",shape=box,style=filled,fillcolor="#f7f9f2",label="Registrar"]; b13 [group="b",shape=box,style=filled,fillcolor="#f7f9f2",label="Browser"]; v13 [group="v",shape=box,style=filled,fillcolor="#f7f9f2",label="HTTP view"]; s13 [group="s",shape=box,style=filled,fillcolor="#f7f9f2",label="Application service"]; d13 [group="d",shape=box,style=filled,fillcolor="#f7f9f2",label="Repository / PostgreSQL"]; r13 -> b13 -> v13 -> s13 -> d13 [style=invis,weight=100];}
r0 -> r1 -> r2 -> r3 -> r4 -> r5 -> r6 -> r7 -> r8 -> r9 -> r10 -> r11 -> r12 -> r13 [style=dashed,arrowhead=none,weight=100];
b0 -> b1 -> b2 -> b3 -> b4 -> b5 -> b6 -> b7 -> b8 -> b9 -> b10 -> b11 -> b12 -> b13 [style=dashed,arrowhead=none,weight=100];
v0 -> v1 -> v2 -> v3 -> v4 -> v5 -> v6 -> v7 -> v8 -> v9 -> v10 -> v11 -> v12 -> v13 [style=dashed,arrowhead=none,weight=100];
s0 -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 -> s9 -> s10 -> s11 -> s12 -> s13 [style=dashed,arrowhead=none,weight=100];
d0 -> d1 -> d2 -> d3 -> d4 -> d5 -> d6 -> d7 -> d8 -> d9 -> d10 -> d11 -> d12 -> d13 [style=dashed,arrowhead=none,weight=100];
r1 -> b1 [constraint=false,label="1 Enter case details / assignments"];
b2 -> v2 [constraint=false,label="2 POST form + CSRF token"];
v3 -> s3 [constraint=false,label="3 Validated register_case(actor, data)"];
s4 -> d4 [constraint=false,label="4 BEGIN; lock active assignees"];
s5 -> s5 [constraint=false,label="5 Generate cryptographic CIN"];
s6 -> d6 [constraint=false,label="6 INSERT case; UNIQUE(CIN)"];
s7 -> d7 [constraint=false,label="7 INSERT representations + audit"];
s8 -> d8 [constraint=false,label="8 COMMIT transaction"];
s9 -> v9 [constraint=false,label="9 Return persisted case",style=dashed];
v10 -> b10 [constraint=false,label="10 Redirect to case URL",style=dashed];
b11 -> v11 [constraint=false,label="11 GET saved case"];
v12 -> b12 [constraint=false,label="12 Render detail + CIN confirmation",style=dashed];
note [shape=note,label="Before service: login, Registrar role, CSRF and form validation.\nInvalid assignee or failed write: rollback all writes.\nCIN collision: rollback and retry (maximum five attempts).\nGET detail uses the same server-side visibility policy."];
s13 -> note [style=invis];
}
